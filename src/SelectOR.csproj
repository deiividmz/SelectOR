<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SelectOR</AssemblyName>
    <RootNamespace>SelectOR</RootNamespace>
    <Product>SelectOR</Product>
    <AssemblyTitle>SelectOR</AssemblyTitle>
    <Company>David MZP</Company>
    <Copyright>© 2026 David MZP. Licencia GNU GPL v3.</Copyright>
    <Version>1.2.62</Version>
    <AssemblyVersion>1.2.62.0</AssemblyVersion>
    <FileVersion>1.2.62.0</FileVersion>

    <!-- Carpeta de una instalación de Open Rails (la que contiene OpenRails.exe). Por defecto,
         «OR Desplegado» junto a esta carpeta; se cambia al compilar con
         dotnet build -p:ORDir="C:\Open Rails\Program" -->
    <ORDir Condition="'$(ORDir)' == ''">..\OR Desplegado\</ORDir>
    <ORPath>$([MSBuild]::EnsureTrailingSlash('$(ORDir)'))</ORPath>
    <!-- Compilamos directamente dentro de esa carpeta de Open Rails para que todas las DLLs
         dependientes (MonoGame, GNU.Gettext, etc.) se resuelvan en tiempo de ejecucion.
         El .exe queda junto a Menu.exe. -->
    <OutputPath>$(ORPath)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No tocamos las DLLs de OR: las referenciamos sin copiarlas. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ApplicationIcon>SelectOR.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- El guardián de señales del multijugador es un proyecto aparte (SignalGuard\): no se compila aquí. -->
  <ItemGroup>
    <Compile Remove="SignalGuard\**" />
    <None Remove="SignalGuard\**" />
  </ItemGroup>
  <!-- …pero se compila antes y va DENTRO de SelectOR.dll (con Harmony): SelectOR lo deja junto a Open Rails al entrar en
       multijugador (SignalGuardFiles.cs). Así llega con la actualización de siempre, que solo instala sus propios archivos. -->
  <Target Name="BuildSignalGuard" BeforeTargets="BeforeBuild">
    <MSBuild Projects="SignalGuard\SelectOR.SignalGuard.csproj" Targets="Restore" Properties="Configuration=$(Configuration);ORDir=$([System.IO.Path]::GetFullPath('$(ORPath)'));_SgRestore=1" />
    <MSBuild Projects="SignalGuard\SelectOR.SignalGuard.csproj" Targets="Build" Properties="Configuration=$(Configuration);ORDir=$([System.IO.Path]::GetFullPath('$(ORPath)'))" />
    <ItemGroup>
      <!-- .NET 6 (StartupHook) y .NET Framework (GuardDomainManager): SelectOR deja la que toca junto a Open Rails -->
      <EmbeddedResource Include="SignalGuard\bin\net6.0-windows\SelectOR.SignalGuard.dll" LogicalName="signalguard.core.SelectOR.SignalGuard.dll" />
      <EmbeddedResource Include="SignalGuard\bin\net6.0-windows\0Harmony.dll" LogicalName="signalguard.core.0Harmony.dll" />
      <EmbeddedResource Include="SignalGuard\bin\net472\SelectOR.SignalGuard.dll" LogicalName="signalguard.fx.SelectOR.SignalGuard.dll" />
      <EmbeddedResource Include="SignalGuard\bin\net472\0Harmony.dll" LogicalName="signalguard.fx.0Harmony.dll" />
    </ItemGroup>
  </Target>

  <!-- Shader propio (réplica del Shape Viewer de TSRE5), compilado con mgfxc a DirectX_11.
       Se copia junto al .exe para cargarlo en tiempo de ejecución. -->
  <ItemGroup>
    <None Include="shape.mgfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Pictogramas del pupitre (pantógrafo, disyuntor, faros…): van dentro del .exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Pictogramas\*.png" LogicalName="pict.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Novedades\*.txt" LogicalName="novedades.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Referencias a las DLLs ya compiladas de Open Rails (no se copian, Private=false) -->
  <ItemGroup>
    <Reference Include="Orts.Menu">
      <HintPath>$(ORPath)Orts.Menu.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="Orts.Settings">
      <HintPath>$(ORPath)Orts.Settings.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="Orts.Common">
      <HintPath>$(ORPath)Orts.Common.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="Orts.Formats.Msts">
      <HintPath>$(ORPath)Orts.Formats.Msts.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="Orts.Formats.OR">
      <HintPath>$(ORPath)Orts.Formats.OR.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <!-- SharpDX (viene con Open Rails): emojis en color en el chat (ColorText.cs) -->
    <Reference Include="SharpDX">
      <HintPath>$(ORPath)SharpDX.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX.DXGI">
      <HintPath>$(ORPath)SharpDX.DXGI.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="SharpDX.Direct2D1">
      <HintPath>$(ORPath)SharpDX.Direct2D1.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(ORPath)MonoGame.Framework.dll</HintPath>
      <SpecificVersion>false</SpecificVersion>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
